<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Messages binds the bridge with this. API 31 and up grant it to Messages by its certificate (knownSigner);
         29 and 30 ignore knownCerts, so there LegacyBridgeService stands in and the code check alone guards it
         (docs/CONTRACT.md, Binding and trust). -->
    <permission
        android:name="cz.teous.messages.bridge.permission.BIND"
        android:knownCerts="@array/trusted_callers"
        android:protectionLevel="signature|knownSigner"
        tools:targetApi="31" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The liquid-glass kit plays its confirm cue through the vibrator. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The status page checks that Messages is installed and is T's. -->
    <queries>
        <package android:name="cz.teous.messages" />
    </queries>

    <application
        android:name=".BridgeApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Black">

        <activity
            android:name=".ui.StatusActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.BridgeService"
            android:enabled="@bool/knownSigner"
            android:exported="true"
            android:permission="cz.teous.messages.bridge.permission.BIND">
            <intent-filter>
                <action android:name="cz.teous.messages.bridge.action.BIND" />
            </intent-filter>
        </service>

        <service
            android:name=".service.LegacyBridgeService"
            android:enabled="@bool/noKnownSigner"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="cz.teous.messages.bridge.action.BIND" />
            </intent-filter>
        </service>

        <service
            android:name=".wake.NetworkNotifications"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
