<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone: the stores hold each network's keys, and whoever copies them can read and send as the
     person. no_backup is never copied anyway; this covers everything else too. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
